# Required in production. Keep this key in the host's secret manager.
GEMINI_API_KEY=replace_with_your_private_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Required in production for persistent, expiring share links.
# Use a managed PostgreSQL URL supplied by your host/database provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Set to the actual number of trusted reverse proxies in front of this app.
# Keep 0 when connecting directly; do not guess this value.
TRUST_PROXY_HOPS=0

# The hosting provider normally sets PORT.
# PORT=3000
